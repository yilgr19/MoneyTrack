{
  "name": "moneytrack-monorepo-root",
  "private": true,
  "description": "Delega scripts a mobile/. npm start = LAN + 8082 + adb reverse (depuración inalámbrica por defecto).",
  "scripts": {
    "start": "node mobile/scripts/run-expo.cjs start",
    "start:localhost": "node mobile/scripts/run-expo.cjs start --localhost",
    "start:clear": "node mobile/scripts/run-expo.cjs start --clear",
    "start:wifi": "node mobile/scripts/run-expo.cjs start",
    "start:tunnel": "node mobile/scripts/run-expo.cjs start --dev-client --tunnel --clear",
    "android:adb-reverse": "node mobile/scripts/adb-reverse.cjs"
  }
}
