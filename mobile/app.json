{
  "expo": {
    "name": "MoneyTrack",
    "slug": "moneytrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/moneytrack-logo.jpg",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0812",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/moneytrack-logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moneytrack.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/moneytrack-logo.jpg",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.moneytrack.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/moneytrack-logo.jpg"
    },
    "scheme": "moneytrack",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/moneytrack-logo.jpg",
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "overlay-swipe",
          "backgroundColor": "#0c0812"
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "MoneyTrack usa la cámara para leer el texto del recibo y sugerir monto y fecha.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
