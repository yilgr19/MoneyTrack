{
  "expo": {
    "name": "MoneyTrack",
    "slug": "moneytrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/moneytrack-logo.jpg",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0812",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/moneytrack-logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moneytrack.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/moneytrack-logo.jpg",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.moneytrack.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/moneytrack-logo.jpg"
    },
    "scheme": "moneytrack",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/moneytrack-logo.jpg",
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "overlay-swipe",
          "backgroundColor": "#0c0812"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4B246C",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MoneyTrack usa la cámara para leer el texto del recibo y sugerir monto y fecha.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "expo-navigation-bar": {
        "visibility": "hidden",
        "behavior": "overlay-swipe",
        "backgroundColor": "#0c0812"
      },
      "eas": {
        "projectId": "d890462f-c782-4d69-bb92-af008be49a43"
      }
    },
    "owner": "yilyan19"
  }
}
