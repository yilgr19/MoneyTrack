{
  "expo": {
    "name": "MoneyTrack",
    "slug": "moneytrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0812",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c0812"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moneytrack.app",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "MoneyTrack envía recordatorios de pagos, metas, presupuesto y lista de compras para que no se te pasen, incluso con la app cerrada."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e0b2e"
      },
      "package": "com.moneytrack.app",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "scheme": "moneytrack",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0812",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "overlay-swipe",
          "backgroundColor": "#0c0812"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4B246C",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "extra": {
      "expo-navigation-bar": {
        "visibility": "hidden",
        "behavior": "overlay-swipe",
        "backgroundColor": "#0c0812"
      },
      "eas": {
        "projectId": "d890462f-c782-4d69-bb92-af008be49a43"
      }
    },
    "owner": "yilyan19"
  }
}
