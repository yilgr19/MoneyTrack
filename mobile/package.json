{
  "name": "moneytrack-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node scripts/run-expo.cjs start",
    "start:wifi": "node scripts/run-expo.cjs start --dev-client --lan --clear --port 8082",
    "android:adb-reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8082 tcp:8082",
    "android:purge-native-cache": "node scripts/purge-android-native-cache.cjs",
    "start:offline": "node scripts/run-expo.cjs start --offline",
    "start:web-mobile": "node scripts/run-expo.cjs start --web",
    "start:offline:web-mobile": "node scripts/run-expo.cjs start --offline --web",
    "android": "node scripts/run-expo.cjs start --android",
    "ios": "node scripts/run-expo.cjs start --ios",
    "web": "node scripts/run-expo.cjs start --web",
    "export:web": "node scripts/run-expo.cjs export --platform web --output-dir web-build",
    "preview:web": "npx --yes serve web-build -l 4173",
    "prebuild": "node scripts/run-expo.cjs prebuild",
    "run:android": "node scripts/run-expo.cjs run:android",
    "run:ios": "node scripts/run-expo.cjs run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "^2.11.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "expo": "^54.0.33",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.21",
    "expo-linear-gradient": "~15.0.8",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "^0.32.17",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-text-extractor": "^2.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.0",
    "react-native-web": "^0.21.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "babel-preset-expo": "~54.0.10"
  },
  "private": true
}
